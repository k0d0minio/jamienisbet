# Copy to .env (gitignored) and fill. Sensitive keys also live in the Vercel env store.
# Business facts (NIF, IBAN, rates) are NOT secrets — they live in _config/business/.
# See _config/conventions/governance.md.

# Email (Resend) — used by scripts/send-email.sh
RESEND_API_KEY=

# Payments / accounting (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Hosting (Vercel)
VERCEL_TOKEN=

# Source control (GitHub) — e.g. creating client delivery repos
GITHUB_TOKEN=
