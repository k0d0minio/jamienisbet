# Copy to .env.local (gitignored) and fill in for local work. Sensitive values
# also live in the Vercel env store. Business facts are not secrets — they live
# in _config/business/. See _config/conventions/governance.md.

# Neon Postgres — the shared business database (same integration as the other sites).
DATABASE_URL=

# Admin auth — the single owner password and the secret used to sign the session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Stripe — server secret key. Owner-only surface, so it reads financials and
# raises invoices/payment links directly. Use a TEST key locally. With it unset,
# the Money page renders a "not configured" notice and the Leads screen is
# unaffected.
STRIPE_SECRET_KEY=

# Public origin, used to build absolute URLs. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub — powers client delivery repos: from a lead's profile, connect an
# existing repo or create a fresh one (needs `repo` scope on a PAT, or
# Contents+Metadata read and Administration write on a fine-grained token).
# Optional: with GITHUB_TOKEN unset the profile shows a "not configured" note
# instead of the connect/create controls; the rest of the admin is unaffected.
GITHUB_TOKEN=
# Where NEW client repos are created. Defaults to the token's own account; set
# to a different user or an organisation to home client repos there instead.
# GITHUB_REPO_OWNER=

# Customer questionnaires ("Send form" on a lead's profile). The form itself is
# served by the portfolio, so the dashboard needs to know where that is in order
# to show a pasteable link. Defaults to https://jamienisbet.com — point it at a
# preview deployment or http://localhost:3000 to test the whole round trip.
# PORTFOLIO_BASE_URL=
# Questions live in `.icm/onboarding/` in this repo and are read off disk. If
# that folder ever fails to ship with the deployment, the dashboard falls back
# to reading it over the GitHub API using GITHUB_TOKEN above; this names the
# repo to read from (defaults to k0d0minio/jamienisbet).
# ONBOARDING_REPO=
