# Contact form delivery.
# When RESEND_API_KEY is set, the contact form sends the enquiry by email
# (see app/actions/contact.ts). Without it, the form validates and shows
# success but does NOT send. Copy this file to `.env.local` and fill in the
# key to go live. Never commit `.env.local`.
#
# Note: the to/from addresses are currently HARDCODED in app/actions/contact.ts
#   to:   jamie.nisbet@outlook.be
#   from: Jamie Nisbet Consultancy <noreply@mail.jamienisbet.com>
# We can move them back into env vars later.
#
# Get a key at https://resend.com → API Keys
RESEND_API_KEY=

# Resend Template ID for the contact-form-notification email (see
# packages/ui/emails/README.md — publish packages/ui/emails/contact-form-notification.html
# in the Resend dashboard, then paste its template ID here). Without this the form still
# validates and shows success but does NOT send.
RESEND_CONTACT_NOTIFICATION_TEMPLATE_ID=

# Database (shared Neon Postgres).
# The contact form persists each enquiry to the `biz.contact_submissions` table
# via @jamie-nisbet/services; the email above is then just a notification. Without
# DATABASE_URL the form still works (email-only) and logs the lead. On Vercel this
# is provided by the Neon integration. Get the connection string from the Neon
# dashboard (pooled connection).
DATABASE_URL=
