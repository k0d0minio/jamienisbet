# Contact form delivery — wired later.
# Until RESEND_API_KEY is set, the contact form validates input and shows
# success but does NOT send (see app/actions/contact.ts). Copy this file to
# `.env.local` and fill in the values to go live. Never commit `.env.local`.
#
# Get a key at https://resend.com → API Keys
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@jamienisbet.com
CONTACT_FROM_EMAIL=
