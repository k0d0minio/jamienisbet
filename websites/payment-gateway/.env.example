# Copy to .env (gitignored) and fill with Stripe TEST keys for local work.
# Sensitive keys also live in the Vercel env store. Business facts are not
# secrets — they live in _config/business/. See _config/conventions/governance.md.
#
# With these unset, the app still runs: /pay/demo renders a demo invoice and the
# checkout area shows a "demo mode" notice instead of a live Stripe form.

# Stripe — publishable key is exposed to the browser (mounts Embedded Checkout).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe — server secret (creates the Checkout Session, reads the invoice).
STRIPE_SECRET_KEY=
# Stripe — webhook signing secret (verifies events at /api/webhooks/stripe).
# Local: get it from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=

# Public origin, used to build the Embedded Checkout return_url.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
