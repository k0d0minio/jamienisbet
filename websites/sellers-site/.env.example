# Lead delivery — wired later.
# Until RESEND_API_KEY is set, both referral forms validate input and show
# success but do NOT send or persist anything (see app/actions/referral.ts).
# This honours the repo rule "no outbound action without review". Copy this
# file to `.env.local` and fill in the values to go live. Never commit `.env.local`.
#
# Get a key at https://resend.com → API Keys
RESEND_API_KEY=
LEAD_TO_EMAIL=contact@jamienisbet.com
LEAD_FROM_EMAIL=
