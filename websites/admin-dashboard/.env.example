# Copy to .env.local (gitignored) and fill in for local work. Sensitive values
# also live in the Vercel env store. Business facts are not secrets — they live
# in _config/business/. See _config/conventions/governance.md.

# Neon Postgres — the shared business database (same integration as the other sites).
DATABASE_URL=

# Admin auth — the single owner password and the secret used to sign the session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Stripe — server secret key. Owner-only surface, so it reads financials and
# raises invoices/payment links directly. Use a TEST key locally. With it unset,
# the Finances/Invoices/Payment-links pages render a "not configured" notice and
# the rest of the admin still works.
STRIPE_SECRET_KEY=

# Public origin, used to build absolute URLs. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel AI Gateway — powers the pipeline's AI (app/api/ai/*: brainstorm, pitch,
# proposal). With it unset, the routes return a "not configured" response and the
# rest of the admin still works. Optional per-tier model overrides (gateway
# "creator/model" slugs) swap models without a code change — defaults live in
# @jamie-nisbet/icm and mirror _config/conventions/model-and-scaling.md.
# AI_MODEL_RESEARCH is the web-connected model the brainstorm's research tool
# runs on (must be a search-capable model, e.g. Perplexity Sonar).
AI_GATEWAY_API_KEY=
# AI_MODEL_HEAVY=anthropic/claude-opus-4.5
# AI_MODEL_STANDARD=anthropic/claude-sonnet-4.5
# AI_MODEL_FAST=anthropic/claude-haiku-4.5
# AI_MODEL_RESEARCH=perplexity/sonar-pro

# GitHub — one token powers two things:
#   1. Repo sync-back: approved pipeline documents are committed to the client's
#      folder (shared/clients/<slug>/documents/) in GITHUB_REPO ("owner/name")
#      so the repo stays the canonical business record.
#   2. Client delivery repos: from a client's profile, connect an existing repo
#      or create a fresh one, which the pipeline's AI runs then analyse for
#      tailored suggestions (needs `repo` scope on a PAT, or Contents+Metadata
#      read and Administration write on a fine-grained token).
# Optional: with GITHUB_TOKEN unset, approval still works (sync skipped) and the
# profile shows a "not configured" note instead of the connect/create controls.
GITHUB_TOKEN=
GITHUB_REPO=k0d0minio/jamienisbet
# Where NEW client repos are created. Defaults to the token's own account; set
# to a different user or an organisation to home client repos there instead.
# GITHUB_REPO_OWNER=
