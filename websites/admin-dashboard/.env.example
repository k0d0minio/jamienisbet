# Copy to .env.local (gitignored) and fill in for local work. Sensitive values
# also live in the Vercel env store. Business facts are not secrets — they live
# in _config/business/. See _config/conventions/governance.md.

# Neon Postgres — the shared business database (same integration as the other sites).
DATABASE_URL=

# Admin auth — the single owner password and the secret used to sign the session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Stripe — server secret key. Owner-only surface, so it reads financials and
# raises invoices/payment links directly. Use a TEST key locally. With it unset,
# the Finances/Invoices/Payment-links pages render a "not configured" notice and
# the rest of the admin still works.
STRIPE_SECRET_KEY=

# Public origin, used to build absolute URLs. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
