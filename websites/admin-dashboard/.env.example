# Manifest of every variable this app needs — names and notes only, never values.
# Values live in the Vercel project; for local work copy to .env.local (gitignored)
# or run `.icm/scripts/env.sh pull`. A note's [suffix] names where the key must exist.

# Neon Postgres (shared) — pooled connection string for the biz.* schema. On Vercel
# the Neon integration sets it.  [production,preview]
DATABASE_URL=

# The single owner password for the dashboard login.  [production,preview]
ADMIN_PASSWORD=

# Secret that signs the owner's session cookie.  [production,preview]
ADMIN_SESSION_SECRET=

# Stripe server secret key — the Money page reads financials and raises draft
# invoices/payment links. Use a TEST key locally; unset, Money shows "not configured".  [production,preview]
STRIPE_SECRET_KEY=

# Vercel AI Gateway key for @jamie-nisbet/services' AI calls; on Vercel the
# platform's OIDC token also authorises the Gateway.  [production,preview]
AI_GATEWAY_API_KEY=

# GitHub token — client delivery repos (connect/create from a lead's profile), the
# Tickets board, deal folders and house forms from icm-board. Needs repo scope (or
# fine-grained Contents+Metadata read, Administration write). Unset, those surfaces
# show "not configured" and the rest of the admin is unaffected.  [production,preview]
GITHUB_TOKEN=

# Where NEW client repos are created. Default: the token's own account.  [optional]
GITHUB_REPO_OWNER=

# Base URL of the portfolio, for pasteable form links. Default: https://jamienisbet.com;
# point it at a preview or http://localhost:3000 to test the round trip.  [optional]
PORTFOLIO_BASE_URL=

# The pipeline's GitHub credential (.icm/project.json required_env) — set in the Claude
# cloud environment panel; a local session uses a logged-in gh instead.  [cloud]
GH_TOKEN=

# --- Set by the Neon–Vercel integration. The code reads DATABASE_URL only; these are
# --- declared so the audit knows they are expected on Vercel. Never set by hand.

# Neon integration — direct (non-pooled) connection string; unused by the code.  [production,preview]
DATABASE_URL_UNPOOLED=

# Neon integration — Neon Auth endpoint; unused by the code.  [production,preview]
NEON_AUTH_BASE_URL=

# Neon integration — the Neon project's id; unused by the code.  [production,preview]
NEON_PROJECT_ID=

# Neon integration — libpq database name; unused by the code.  [production,preview]
PGDATABASE=

# Neon integration — libpq pooled host; unused by the code.  [production,preview]
PGHOST=

# Neon integration — libpq direct host; unused by the code.  [production,preview]
PGHOST_UNPOOLED=

# Neon integration — libpq password; unused by the code.  [production,preview]
PGPASSWORD=

# Neon integration — libpq user; unused by the code.  [production,preview]
PGUSER=

# Neon integration — database name, legacy Vercel Postgres naming; unused by the code.  [production,preview]
POSTGRES_DATABASE=

# Neon integration — host, legacy Vercel Postgres naming; unused by the code.  [production,preview]
POSTGRES_HOST=

# Neon integration — password, legacy Vercel Postgres naming; unused by the code.  [production,preview]
POSTGRES_PASSWORD=

# Neon integration — Prisma-style connection string; unused by the code.  [production,preview]
POSTGRES_PRISMA_URL=

# Neon integration — pooled connection string, legacy naming; unused by the code.  [production,preview]
POSTGRES_URL=

# Neon integration — direct connection string, legacy naming; unused by the code.  [production,preview]
POSTGRES_URL_NON_POOLING=

# Neon integration — connection string without SSL; unused by the code.  [production,preview]
POSTGRES_URL_NO_SSL=

# Neon integration — user, legacy Vercel Postgres naming; unused by the code.  [production,preview]
POSTGRES_USER=

# Neon integration — Neon Auth URL for Vite clients; unused by the code.  [production,preview]
VITE_NEON_AUTH_URL=
