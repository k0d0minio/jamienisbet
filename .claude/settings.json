{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(_system/icm-check.sh:*)",
      "Bash(_system/tickets-board.sh:*)",
      "Bash(_system/ticket-hygiene.sh:*)",
      "Bash(_system/pull-all.sh:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/_system/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
