{
  "name": "@jamie-nisbet/services",
  "version": "0.1.0",
  "private": true,
  "description": "Jamie Nisbet shared services — the database models and logic (Drizzle ORM over Neon Postgres) consumed by every website under websites/. Source-only, no build step.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./queries/*": {
      "types": "./src/queries/*.ts",
      "default": "./src/queries/*.ts"
    }
  },
  "files": [
    "src",
    "scripts",
    "drizzle",
    "drizzle.config.ts",
    "README.md"
  ],
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "leads-import": "tsx scripts/leads-import.ts",
    "leads-queue": "tsx scripts/leads-queue.ts",
    "leads-log": "tsx scripts/leads-log.ts",
    "leads-crack": "tsx scripts/leads-crack.ts",
    "leads-enrich": "tsx scripts/leads-enrich.ts",
    "leads-purge": "tsx scripts/leads-purge.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "ai": "^7.0.85",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
