{
  "name": "@jamie-nisbet/app-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Jamie Nisbet shared Next.js app shell for the public marketing sites — i18n routing/navigation, theme provider + toggle, language switcher, layout sections, and the parametrised site header/footer. Source-only (each app transpiles it); Next/next-intl/next-themes-coupled pieces live here, framework-light primitives stay in @jamie-nisbet/ui.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    },
    "./i18n/request": {
      "types": "./src/i18n/request.ts",
      "default": "./src/i18n/request.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jamie-nisbet/ui": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": ">=1",
    "next": ">=16",
    "next-intl": ">=4",
    "next-themes": ">=0.4",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.20.0",
    "next": "^16.3.6",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3"
  }
}
