{
  "name": "@jamie-nisbet/ui",
  "version": "0.2.0",
  "private": true,
  "description": "Jamie Nisbet shared design system — brand tokens, assets, and reusable React components (Tailwind v4 + shadcn/ui) consumed by every website under websites/.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./styles.css",
    "./app.css": "./app.css",
    "./desk.css": "./desk.css",
    "./tokens.css": "./tokens.css",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*",
    "./emails/*.html": "./emails/*.html",
    "./emails/template-ids": {
      "types": "./emails/template-ids.ts",
      "default": "./emails/template-ids.ts"
    },
    "./lib/utils": "./src/lib/utils.ts",
    "./components/*": "./src/components/*"
  },
  "files": [
    "src",
    "styles.css",
    "app.css",
    "desk.css",
    "tokens.css",
    "tokens",
    "assets",
    "emails",
    "components.json",
    "README.md",
    "BRAND.md",
    "SKILL.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:css": "tailwindcss -i ./styles.css -o /dev/null",
    "check:css:app": "tailwindcss -i ./app.css -o /dev/null",
    "check:css:desk": "tailwindcss -i ./desk.css -o /dev/null",
    "lint": "pnpm check:css && pnpm check:css:app && pnpm check:css:desk"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.20.0",
    "motion": "13.1.1",
    "radix-ui": "^1.6.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
