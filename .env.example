# Manifest of every variable this app needs — names and notes only, never values.
# Values live in the Vercel project; for local work copy to .env.local (gitignored).
# A note's [suffix] names where the key must exist.

# Resend key — the contact form emails each enquiry (app/actions/contact.ts). Without
# it the form validates and shows success but does NOT send. The to/from addresses
# are hardcoded there; the template ID lives in emails/template-ids.ts.  [production,preview]
RESEND_API_KEY=

# The desk's pool API — the contact form posts each lead there as a prospect
# (app/actions/contact.ts). The full route: https://desk.jamienisbet.com/api/pool.
# Without both, the form skips the pool and works email-only.  [production,preview]
DESK_POOL_URL=

# Bearer token for the pool API — the desk's POOL_TOKEN.  [production,preview]
DESK_POOL_TOKEN=
